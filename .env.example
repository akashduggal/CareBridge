# Firebase configuration
# Obtain these values from your Firebase project settings:
# https://console.firebase.google.com → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# WebSocket server URL for real-time updates
# Defaults to ws://localhost:3000 if not set
VITE_WS_URL=ws://localhost:3000
